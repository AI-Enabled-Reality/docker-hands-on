# syntax=docker/dockerfile:1
# Lesson 10.3, the break: install a package from the internal index, whose certificate the image
# doesn't trust.
#   docker build -f module-10/03-ca-trust/Dockerfile.no-ca module-10/03-ca-trust
FROM python:3.14.9-slim-trixie
COPY --from=ghcr.io/astral-sh/uv:0.13.5 /uv /bin/uv
RUN uv pip install --system --index-url https://host.docker.internal:8443/simple/ brightlane-tariffs
