# syntax=docker/dockerfile:1
# Lesson 4.4: the token as a build secret. It exists only while this one RUN runs.
#   docker build -f module-04/04-build-secrets/Dockerfile.secret --build-context scripts=module-04/04-build-secrets \
#     --secret id=rulebook_token,src=.lab/m04l04/rulebook-token.txt -t brightlane/pricing:0.6 .lab/m04l04
FROM brightlane/pricing:0.5
RUN --mount=type=bind,from=scripts,source=fetch_rulebook.py,target=/tmp/fetch_rulebook.py \
    --mount=type=secret,id=rulebook_token,env=RULEBOOK_TOKEN \
    python /tmp/fetch_rulebook.py
