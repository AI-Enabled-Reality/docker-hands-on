# syntax=docker/dockerfile:1
# The pricing service for development (lesson 9.1): the code stays in /app/src, installed in editable
# mode, and the API restarts when a file changes. Never ship this image: it runs as root, with uv and
# the test tools.
#   docker build -f app/Dockerfile.dev -t brightlane/pricing:dev app
FROM python:3.14.9-slim-trixie
COPY --from=ghcr.io/astral-sh/uv:0.13.5 /uv /bin/uv
ENV UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=0 PYTHONUNBUFFERED=1 PATH="/app/.venv/bin:$PATH"
WORKDIR /app
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --locked --no-install-project
COPY . .
# Editable: the environment points at /app/src, where Compose Watch copies your edits.
RUN --mount=type=cache,target=/root/.cache/uv uv sync --locked
EXPOSE 8000
ENTRYPOINT ["pricing"]
CMD ["api", "--reload"]
